# OS
.DS_Store

# Local tool caches
.impeccable/

# Large media (kept local; use external storage/LFS if it must be shared)
*.MP4
*.mp4
*.mov

# Xcode / Swift
xcuserdata/
DerivedData/
*.xcodeproj/project.xcworkspace/xcuserdata/
.build/
*.ipa
*.dSYM.zip
# Xcode Cloud needs the shared project present at checkout. Keep local workspace state ignored.
apps/ios/BADAN.xcodeproj/*
!apps/ios/BADAN.xcodeproj/project.pbxproj
!apps/ios/BADAN.xcodeproj/project.xcworkspace/
apps/ios/BADAN.xcodeproj/project.xcworkspace/*
!apps/ios/BADAN.xcodeproj/project.xcworkspace/xcshareddata/
apps/ios/BADAN.xcodeproj/project.xcworkspace/xcshareddata/*
!apps/ios/BADAN.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
apps/ios/BADAN.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!apps/ios/BADAN.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
!apps/ios/BADAN.xcodeproj/xcshareddata/
apps/ios/BADAN.xcodeproj/xcshareddata/*
!apps/ios/BADAN.xcodeproj/xcshareddata/xcschemes/
!apps/ios/BADAN.xcodeproj/xcshareddata/xcodecloud/
# CI's -resultBundlePath (ci.yml) and any local `-resultBundlePath TestResults.xcresult` run land
# here, outside `build/` (build/ is already ignored below) — a stray result bundle from a local
# invocation was found untracked in the working tree; ignore the path so it can't be re-added.
apps/ios/TestResults.xcresult/
# xcodebuild -derivedDataPath output. `build/` below catches apps/ios/build/, but a device build
# uses a separate path (see docs/TESTFLIGHT.md) that the bare `build/` pattern does not match.
apps/ios/build-device/

# Android / Gradle
.gradle/
build/
local.properties
*.apk
*.aab
captures/

# Python
__pycache__/
*.pyc
.venv/

# Node (if ever introduced)
node_modules/

# Misc
*.log
