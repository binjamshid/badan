  "knownDivergences": [
    {
      "id": "workout-totals-energy-unit",
      "field": "workouts[].totals energy",
      "ios": "WorkoutTotals.energyKcal (kilocalories) -> emitted as `energy_kcal`",
      "android": "WorkoutTotals.energyKj (kilojoules) -> emitted as `energy_kj`",
      "why": "EPIC-03 landed the typed workout payload independently on the two platforms and they chose different stored units for energy. The writers publish the unit in the key name rather than converting, because converting a lineage record introduces float residue into the one field whose job is to preserve what the source said.",
      "fix": "Pick one stored unit in both domains' WorkoutTotals (kJ is the canonical-unit choice the rest of the store makes), migrate the stored payloads, then delete the losing key from json_bundle.schema.json and this entry.",
      "fixtureHandling": "The fixture workout carries NO energy total, so the golden stays byte-identical while the divergence exists."
    },
    {
      "id": "workout-hr-series-ref",
      "field": "workouts[].hr_series_ref",
      "ios": "WorkoutDetail.hrSeriesRef exists; the key is emitted when set",
      "android": "WorkoutDetail has no hrSeriesRef field; the key is never emitted",
      "why": "The HR-linkage pointer was added to the iOS payload by EPIC-03 and not mirrored. Android fabricating `{\"metric_id\": \"heart.hr\"}` would assert a linkage BADAN never recorded on that device.",
      "fix": "Add `hrSeriesRef: String? = null` to Android's WorkoutDetail and stamp it where iOS does, then give the fixture workout an hrSeriesRef and delete this entry.",
      "fixtureHandling": "The fixture workout has NO hrSeriesRef, so the golden stays byte-identical while the divergence exists."
    },
    {
      "id": "manifest-sample-data-row-count",
      "field": "manifest.sample_data_row_count",
      "ios": "ExportManifest.sampleDataRowCount is a stored field; the writer reads it",
      "android": "ExportManifest has no such field; the writer takes it as a parameter defaulting to 0",
      "why": "The honesty counter was added to the iOS manifest and not mirrored into the Android entity.",
      "fix": "Add `sampleDataRowCount: Int = 0` to Android's ExportManifest and compute it in that platform's ExportRunner, then drop the writer parameter.",
      "fixtureHandling": "Both suites pass the fixture's `bundleManifest.sampleDataRowCount` explicitly, so the golden is identical; what is NOT proven by this fixture is that each platform's ExportRunner computes the same number."
    }
  ]
