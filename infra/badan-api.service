[Unit]
Description=BADAN AI Coach API (A9 / ADR-0010)
After=network.target

[Service]
Type=simple
User=badan
Group=badan
WorkingDirectory=/srv/badan/code
EnvironmentFile=/srv/badan/config/.env
ExecStart=/srv/badan/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/badan/data

[Install]
WantedBy=multi-user.target
