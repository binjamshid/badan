<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- BADAN is local-first: zero network calls, no third-party SDKs, no analytics, no
	     accounts. Nothing is ever transmitted off-device, so there is no tracking and no
	     "collected data" in the App Store Privacy Nutrition Label sense — reading/writing
	     data into the app's own on-device SQLite databases and UserDefaults is on-device
	     processing, not "collection," which Apple's privacy manifest spec defines as
	     transmission off the device (or to a third party on-device).

	     A2 (ADR-0009) reviewed and deliberately changed nothing here. Background delivery and
	     BGTaskScheduler let BADAN do the SAME on-device work at a different time; they move no
	     data off the device, add no third party, and introduce no required-reason API
	     (BGTaskScheduler and HKObserverQuery are not on Apple's required-reason list). The
	     widened HealthKit read set likewise adds no collected-data type, because none of it is
	     transmitted. Padding this file with declarations that "look responsible" would make it
	     less accurate, not more — its value is that every entry below is load-bearing.

	     The standing rule: a new entry belongs here only when the app genuinely calls a
	     required-reason API or genuinely transmits something. Re-check on each release. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- Database.swift diskUsage() calls FileManager.attributesOfItem(atPath:) on the app's
		     own DB files (badan.db / badan_sensitive.db and -wal/-shm siblings) under
		     Application Support/BADAN to report on-device storage usage (PERF-122). File
		     timestamps of files inside the app's own container. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<!-- FeatureFlags.swift and AppEnvironment.swift use UserDefaults.standard to store the
		     app's own preferences (onboarding-complete flag, device id, debug feature flags) —
		     never shared with or read from outside the app. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
