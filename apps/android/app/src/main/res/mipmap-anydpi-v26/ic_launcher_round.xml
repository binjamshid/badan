<?xml version="1.0" encoding="utf-8"?>
<!--
  BADAN's launcher icon. The app previously declared no `android:icon` at all and shipped no
  mipmap, so it installed with the system's default grey Android robot — a blocker for Play
  submission and, before that, a health app that looked unfinished on the one surface every user
  sees first.

  `monochrome` is included so Android 13+ themed icons work rather than falling back to the
  full-colour badge on a themed home screen.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
