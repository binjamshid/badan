<?xml version="1.0" encoding="utf-8"?>
<!--
  The icon's teal field, matching the iOS app icon's gradient. Full-bleed by contract: adaptive
  icons let the launcher mask and parallax the background, so it must cover the whole 108dp canvas
  with no art near the edges.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#2C7F6D" />
                <item android:offset="1" android:color="#164F45" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
