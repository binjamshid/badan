    <!--
      التمرين المباشر — قناة الإشعارات وخدمة المقدّمة.

      يقرأ المستخدم اسم القناة ووصفها في إعدادات أندرويد نفسها لا داخل بدن، لذلك يشرح الوصف سبب
      بقاء الإشعار: هو ما يسمح للنظام بمواصلة التسجيل والشاشة مطفأة. ولا يحمل نصّ الإشعار أي قراءة
      صحية — لا تظهر أي قيمة على شاشة القفل.
    -->
    <string name="channel_live_workout_name">تمرين قيد التسجيل</string>
    <string name="channel_live_workout_description">يعرض إشعاراً مستمراً أثناء تسجيل بدن لتمرينك. يحتاجه أندرويد لمواصلة التسجيل والشاشة مطفأة، لذلك يبقى حتى ينتهي التمرين.</string>
    <string name="notification_live_workout_title">يسجّل تمرينك</string>
    <string name="notification_live_workout_text">بدن يسجّل الآن. اضغط للفتح، أو أنهِ التمرين لإيقاف التسجيل.</string>
</resources>
