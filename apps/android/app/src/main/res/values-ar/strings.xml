    <string name="shortcut_workout_long">ابدأ تمريناً</string>

    <!--
      EPIC-33 — تسميات أدوات الشاشة الرئيسية وأوصافها.

      نفس المصطلحات المستعملة في core/Strings.kt: الجاهزية، النوم، الجهد، الأدوية — حتى تقرأ الأداة
      وشاشة التطبيق بالكلمات نفسها. نفس السجل أيضاً: الأداة تعرض رقماً حسبه التطبيق، ولا تَعِد بتفسير.
      وصف أداة الأدوية يقول صراحةً إنها تبقى فارغة حتى تُفعِّل الأدوية في الإعدادات، لأن أداة فارغة
      بلا تفسير تُقرأ على أنها معطّلة.
    -->
    <string name="widget_ring_single_label">الجاهزية</string>
    <string name="widget_ring_single_description">جاهزيتك اليوم بلمحة.</string>
    <string name="widget_one_true_sentence_label">جملة اليوم</string>
    <string name="widget_one_true_sentence_description">جملة واحدة هادئة عن كيف يمضي يومك.</string>
    <string name="widget_meds_due_label">أدوية مستحقّة</string>
    <string name="widget_meds_due_description">الأدوية المستحقّة قريباً، بعد أن تُفعِّل ذلك في الإعدادات.</string>
    <string name="widget_sleep_last_night_label">النوم</string>
    <string name="widget_sleep_last_night_description">مدة نومك الليلة الماضية ودرجتها.</string>
    <string name="widget_effort_ring_label">الجهد</string>
    <string name="widget_effort_ring_description">جهدك اليوم بلمحة.</string>

